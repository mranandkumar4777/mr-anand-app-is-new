{
  "name": "p1-app-pc",
  "productName": "PRESENTER",
  "version": "1.0.6",
  "description": "PRESENTER - lyric / slide presenter with phone remote",
  "main": "main.js",
  "author": "mranandkumar4777",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node tests/ai-hub.test.js && node tests/whisper-setup.test.js && node tests/stage-air.state.test.js && node tests/stage-air.server.test.js && node tests/fx-presets.test.js && node tests/ltpng.test.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.p1.presenter",
    "productName": "PRESENTER",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "ai-hub.js",
      "speech/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/mranandkumar4777/p1-app-pc/releases/download/desktop-latest/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "engines": {
    "node": ">=18"
  }
}
